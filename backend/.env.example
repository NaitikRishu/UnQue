# Port for backend server
PORT=4000

# Meta Webhook Verification Token (set this same secret in Meta App Dashboard)
META_VERIFY_TOKEN=unque_lead_verify_token_2026

# Meta Page Access Token (generated from Meta Graph API Explorer / App Dashboard)
# Leave empty if testing locally with the simulation script
META_PAGE_ACCESS_TOKEN=

# Meta App Secret (optional, used for X-Hub-Signature-256 HMAC verification)
META_APP_SECRET=

# Meta Graph API Version
META_GRAPH_VERSION=v19.0
